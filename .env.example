# =============================================================================
# OpenClaw Credit Risk Agent Configuration
# =============================================================================

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model Selection (e.g., deepseek-r1-distill-llama-70b, llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it)
GROQ_MODEL=deepseek-r1-distill-llama-70b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048

# OpenClaw Environment
OPENCLAW_ENV=development
OPENCLAW_LOG_LEVEL=INFO

# Application & API Settings
HOST=0.0.0.0
PORT=8000
AUDIT_LOG_DIR=openclaw_credit_risk_agent/audit_logs

# Policy Engine Thresholds (Configurable)
POLICY_AUTO_APPROVE_MAX_PD=0.05
POLICY_AUTO_REJECT_MIN_PD=0.25
POLICY_MIN_CREDIT_SCORE=580
POLICY_MAX_DTI=45.0
